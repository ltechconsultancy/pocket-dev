# PocketDev — Coolify production environment
# Generate: ./setup-coolify.sh --domain=pocketdev.example.com
# Paste all lines into Coolify → Docker Compose resource → Environment tab.

# --- Images (required — no :latest default in compose) ---
# Upstream until ltechconsultancy publishes GHCR packages from a GitHub Release:
PD_IMAGE_OWNER=tetrixdev
PD_IMAGE_TAG=v0.67.0
# Fork-only features (e.g. Cursor Agent): after first release on this repo:
# PD_IMAGE_OWNER=ltechconsultancy
# PD_IMAGE_TAG=v0.1.0

# --- Instance ---
PD_PROJECT_NAME=pocket-dev

# Public URL (must match Coolify FQDN on pocket-dev-nginx)
PD_APP_URL=https://pocketdev.example.com
PD_FORCE_HTTPS=true
PD_DOMAIN_NAME=pocketdev.example.com
PD_DEPLOYMENT_MODE=production

# --- Secrets (generate with setup-coolify.sh) ---
PD_APP_KEY=
PD_DB_PASSWORD=
PD_DB_READONLY_PASSWORD=
PD_DB_MEMORY_AI_PASSWORD=

# Host docker group: stat -c '%g' /var/run/docker.sock on the Coolify server
PD_DOCKER_GID=

PD_USER_ID=1000
PD_GROUP_ID=1000

# 4 on a 4 GB VPS, 8 on 8 GB+ (compose default: 8)
PD_QUEUE_WORKERS=8

# Optional: pin Claude Code CLI
# CLAUDE_CODE_VERSION=2.1.17
