# PocketDev — Coolify production environment
# Copy to .env in the Coolify compose resource, or paste variables in the Coolify UI.
# Generate secrets locally: ./setup.sh (from deploy/) then copy values here.

# --- Images (set in Coolify UI or .env) ---
# Registry owner on ghcr.io (ltechconsultancy after your first release; tetrixdev until then)
PD_IMAGE_OWNER=ltechconsultancy
# Pin a release tag, e.g. v0.67.0 — avoid :latest in production
PD_IMAGE_TAG=

# --- Instance ---
PD_PROJECT_NAME=pocket-dev

# Public URL (must match Coolify FQDN on pocket-dev-nginx)
PD_APP_URL=https://pocketdev.example.com
PD_FORCE_HTTPS=true
PD_DOMAIN_NAME=pocketdev.example.com
PD_DEPLOYMENT_MODE=production

# Not used for routing when Traefik/Coolify terminates TLS (leave empty)
PD_NGINX_PORT=

# --- Secrets (generate with deploy/setup.sh) ---
PD_APP_KEY=
PD_DB_PASSWORD=
PD_DB_READONLY_PASSWORD=
PD_DB_MEMORY_AI_PASSWORD=

# Host docker group — on the Coolify server: stat -c '%g' /var/run/docker.sock
PD_DOCKER_GID=

# File ownership in volumes (often 1000:1000 on Ubuntu)
PD_USER_ID=1000
PD_GROUP_ID=1000

# Lower than default 20 — recommended 4–8 on a 4–8 GB VPS
PD_QUEUE_WORKERS=8

# Optional: pin Claude Code CLI version
# CLAUDE_CODE_VERSION=2.1.17
